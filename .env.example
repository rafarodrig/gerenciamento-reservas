### APLICATIVO ###
APP_NAME=Laravel
APP_ENV=local
APP_KEY=    # Execute "php artisan key:generate" após configurar
APP_DEBUG=true
APP_URL=http://localhost:8001
ASSET_URL=http://localhost:5173

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

### LOGS ###
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

### BANCO DE DADOS ###
DB_CONNECTION=mysql
DB_HOST=db               # Nome do serviço no docker-compose
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

### SESSÃO ###
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

### FILA ###
QUEUE_CONNECTION=database

### CACHE ###
CACHE_STORE=database
CACHE_PREFIX=laravel_cache_

### REDIS ###
REDIS_CLIENT=phpredis
REDIS_HOST=redis          # Se estiver usando Redis em container
REDIS_PASSWORD=null
REDIS_PORT=6379

### E-MAIL ###
MAIL_MAILER=log
MAIL_HOST=mailpit         # Use Mailpit ou Mailhog no docker-compose
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

### VITE (HMR) ###
VITE_DEV_SERVER=true
VITE_HOST=0.0.0.0
VITE_PORT=5173
VITE_APP_NAME="${APP_NAME}"
